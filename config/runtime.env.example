LEGOPI_HOME=/home/ty
LEGOPI_OLLAMA_MODEL=qwen2.5:1.5b
LEGOPI_OLLAMA_TIMEOUT=3.0
LEGOPI_WAKE_THRESHOLD=0.80
LEGOPI_AUDIO_DEVICE=0
LEGOPI_LIVE_PORT=5000
# Set when the camera is physically mounted rotated to fit an enclosure.
# One of: none, 90_cw, 90_ccw, 180.
LEGOPI_CAMERA_ROTATE=none
# Set to a third-party camera's native sensor resolution (WIDTHxHEIGHT) if the live
# view looks zoomed in / center-cropped instead of showing the full field of view.
# Example for the Arducam IMX519: LEGOPI_CAMERA_SENSOR_SIZE=4656x3496
LEGOPI_CAMERA_SENSOR_SIZE=
